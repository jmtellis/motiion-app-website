# Copy to .env.local for local testing. Never copy production secrets into staging.
# Optional server-only reads of the live public catalog (home collections, Meet the Cast, and the public pages those cards open).
# The anon key reads public profiles. The secret key is used only for filtered GETs of collections and public events.
# Leave both empty to stay entirely on staging. Never set these on a production deployment.
CATALOG_SUPABASE_URL=
CATALOG_SUPABASE_ANON_KEY=
CATALOG_SUPABASE_SECRET_KEY=
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SUPABASE_URL=https://mvkvztpvakybrhyupown.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3001
ENFORCE_INDUSTRY_PAYWALL=false

# Leave disabled until separate test integrations have been configured.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_INDUSTRY_PRICE_ID=
RESEND_API_KEY=
INTERNAL_EMAIL_TOKEN=
# Comma-separated exact email addresses. Empty means all notification emails blocked.
STAGING_EMAIL_ALLOWLIST=
REVENUECAT_WEBHOOK_SECRET=
NOTION_API_KEY=
NOTION_DATABASE_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
